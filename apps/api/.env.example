APP_ENV=development
SECRET_KEY=change-this-local-secret-key-32-bytes-minimum-demo-value
DATABASE_URL=sqlite:///./data/bhashasaathi.db
STORAGE_DIR=./data/storage
MODEL_DIR=./models
HF_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8000/api/v1
DEMO_MODE=false
TRANSLATION_ENABLED=true
STT_ENABLED=true
TTS_ENABLED=true
LLM_ENABLED=false
CPU_ONLY=false
LOG_LEVEL=INFO
MAX_AUDIO_MB=30
PARLER_DESCRIPTION_TOKENIZER=
MAX_TRANSLATION_CHARS=12000

LIVE_TTS_STREAM_SECONDS=1.0
LIVE_TTS_STREAM_TIMEOUT=15.0

# CPU performance knobs
TORCH_THREADS=6
TEXT_TRANSLATION_BEAMS=1
LIVE_TRANSLATION_BEAMS=1
TRANSLATION_MAX_NEW_TOKENS=512
LIVE_TRANSLATION_MAX_NEW_TOKENS=96
TRANSLATION_ROUTE_CACHE_LIMIT=2

TRANSLATION_INPUT_TOKEN_BUDGET=220
TRANSLATION_BATCH_SIZE=4

# Reserve 4 GB RTX 2050 VRAM for Parler-TTS.
TRANSLATION_CPU_ONLY=true
STT_CPU_ONLY=true
TTS_CPU_ONLY=false

# Safety timeouts: prevents a background job or request from appearing to run forever.
TRANSLATION_REQUEST_TIMEOUT_S=90
PREPARATION_TTS_TIMEOUT_S=600
PREPARATION_PRACTICE_TIMEOUT_S=180
