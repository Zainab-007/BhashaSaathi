APP_ENV=development
SECRET_KEY=change-this-local-secret-key-32-bytes-minimum-demo-value
DATABASE_URL=sqlite:///./data/bhashasaathi.db
STORAGE_DIR=./data/storage
MODEL_DIR=./models
HF_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8000/api/v1

DEMO_MODE=false
TRANSLATION_ENABLED=true
STT_ENABLED=true
TTS_ENABLED=true
LLM_ENABLED=false
CPU_ONLY=false
KEEP_MODELS_LOADED=true

# Windows RTX 2050 profile: keep translation/Whisper on CPU and reserve GPU for TTS.
TRANSLATION_CPU_ONLY=true
STT_CPU_ONLY=true
TTS_CPU_ONLY=false
SANTALI_STT_ENABLED=true
SANTALI_STT_CPU_ONLY=true
SANTALI_STT_MODEL_DIR=./models/stt/indic-conformer-600m-multilingual

# Translation/live performance
TORCH_THREADS=6
TEXT_TRANSLATION_BEAMS=1
LIVE_TRANSLATION_BEAMS=1
TRANSLATION_MAX_NEW_TOKENS=512
LIVE_TRANSLATION_MAX_NEW_TOKENS=96
TRANSLATION_ROUTE_CACHE_LIMIT=2
TRANSLATION_INPUT_TOKEN_BUDGET=220
TRANSLATION_BATCH_SIZE=4
MAX_TRANSLATION_CHARS=12000
MAX_LIVE_SEGMENT_MS=2200
LIVE_MAX_SEGMENT_MS_SANTALI=2800
LIVE_END_SILENCE_MS=280
LIVE_QUEUE_SIZE=2
LIVE_TTS_STREAM_SECONDS=0.5
LIVE_TTS_STREAM_TIMEOUT=12
LIVE_HISTORY_TTL_HOURS=24

# Local Parler-TTS. Keep compile OFF by default on a 4 GB RTX 2050.
PARLER_DESCRIPTION_TOKENIZER=./models/tts/flan-t5-large
PARLER_ATTENTION=eager
PARLER_COMPILE=0
PARLER_MAX_OUTPUT_SECONDS=30
PARLER_LIVE_MAX_OUTPUT_SECONDS=10

# Background safety
TRANSLATION_REQUEST_TIMEOUT_S=90
PREPARATION_TTS_TIMEOUT_S=600
PREPARATION_PRACTICE_TIMEOUT_S=180
